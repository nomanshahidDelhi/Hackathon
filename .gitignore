infra/terraform/.terraform.lock.hcl
*.tfplan

# --- Organiser material & duplicates (confidential / not our work) ---
*.pdf
files_track2_track_2_data/

# --- Query results / exported data (rules: do not commit) ---
exports/
*.csv
*.parquet

# --- Python / Node ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
dist/
*.tsbuildinfo
