# --- Secrets: never commit (grounds for disqualification) ---
*.json.key
*-sa.json
*service-account*.json
application_default_credentials.json
credentials.json
.env
.env.*
!.env.example
*.pem
*.p12

# --- Terraform state / local config ---
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
